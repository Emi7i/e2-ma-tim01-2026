<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFF9E6"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/reward_icon"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="Nagrada"
            android:src="@drawable/icon_rank" />

        <TextView
            android:id="@+id/reward_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Čestitamo!"
            android:textColor="#4A2A00"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reward_placement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="1. mesto"
            android:textColor="#6A1B9A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reward_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nedeljna rang lista"
            android:textColor="#5F5145"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/reward_tokens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="+5 tokena"
            android:textColor="#B26A00"
            android:textSize="25sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reward_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Preuzmi nagradu"
            android:textAllCaps="false"
            app:backgroundTint="#6A1B9A"
            app:cornerRadius="14dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
