<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.fragments.profile.StatisticsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageButton
                    android:id="@+id/closeDrawerButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Statistika"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_dark"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

            <!-- User Header Mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@color/light_gray"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circular_profile_background">

                    <ImageView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/profile_icon"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile_avatar" />

                </FrameLayout>

                <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Korisnicko ime"
                    android:textStyle="bold"
                    android:textColor="@color/field_border"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Success Rate -->
            <TextView
                android:id="@+id/successRateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uspesnost: 0%"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_dark"
                android:layout_marginBottom="24dp" />

            <!-- Progress List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ko zna zna:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressKoZnaZna"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moj broj:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressMojBroj"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Korak po korak:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressKorakPoKorak"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asocijacije:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressAsocijacije"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Skočko:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressSkocko"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spojnice:"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progressSpojnice"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progress="0"
                        android:max="100"
                        android:progressTint="@color/field_background"
                        android:progressBackgroundTint="@color/red" />

                </LinearLayout>

            </LinearLayout>

            <!-- Winrate Chart Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@color/light_gray"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/totalGamesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ukupno odigranih: 0 partija"
                    android:textSize="14sp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="16dp" />

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/circular_profile_background">

                    <View
                        android:id="@+id/pieChart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:id="@+id/winrateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Winrate"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
