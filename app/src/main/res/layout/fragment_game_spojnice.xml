<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.fragments.match.SpojniceFragment">

    <!-- Game Board -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/leftCard1"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard2"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard3"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard4"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard5"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard6"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/leftCard7"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/rightCard1"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard2"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard3"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard4"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard5"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard6"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/rightCard7"
                    style="@style/GameField.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Footer Action -->

</androidx.constraintlayout.widget.ConstraintLayout>
