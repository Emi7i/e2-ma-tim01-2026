<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/seed_text"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#6A1B9A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/league_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Ikonica lige"
        android:src="@drawable/icon_rank" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/username_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Korisničko ime"
            android:textColor="#24132F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/league_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liga"
            android:textColor="#6B6070"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aktivan"
        android:textColor="#2E7D32"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
