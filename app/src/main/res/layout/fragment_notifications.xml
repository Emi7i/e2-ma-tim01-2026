<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/tvNotificationsTitle"
            style="@style/PageTitle"
            android:text="Notifications" />

        <TextView
            android:id="@+id/notif1"
            style="@style/GameField"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="start|center_vertical"
            android:text="Igrač Marko vas je pozvao u igru." />

        <TextView
            android:id="@+id/notif2"
            style="@style/GameField"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="start|center_vertical"
            android:text="Vaš protivnik je završio potez." />

        <TextView
            android:id="@+id/notif3"
            style="@style/GameField"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="start|center_vertical"
            android:text="Osvojili ste 20 poena u prethodnoj partiji." />

        <TextView
            android:id="@+id/notif4"
            style="@style/GameField"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="start|center_vertical"
            android:text="Imate novu poruku." />

        <TextView
            android:id="@+id/notif5"
            style="@style/GameField"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="start|center_vertical"
            android:text="Turnir počinje za 5 minuta." />

    </LinearLayout>

</ScrollView>