<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.common.HomeFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Home!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="354dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <Button
            android:id="@+id/koZnaZna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ko zna zna" />

        <Button
            android:id="@+id/spojnice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spojnice" />

        <Button
            android:id="@+id/asocijacije"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asocijacije" />

        <Button
            android:id="@+id/skocko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skocko" />

        <Button
            android:id="@+id/korakPoKorak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Korak po korak" />

        <Button
            android:id="@+id/mojBroj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moj broj" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>