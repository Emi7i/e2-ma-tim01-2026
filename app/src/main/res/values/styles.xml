<resources>
<!--    Common-->
    <style name="PageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/spacing_lg</item>
    </style>
<!--    Game-->
    <style name="GameField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/game_field_background</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:gravity">center</item>
    </style>
<!--    Auth-->
    <style name="AuthInput">
        <item name="android:layout_width">300dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
    </style>
    <style name="AuthButton">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

</resources>